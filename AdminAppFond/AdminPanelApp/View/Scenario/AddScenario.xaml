<ex:ExWindow x:Class="AdminPanelApp.View.Scenario.AddScenario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
        xmlns:local="clr-namespace:AdminPanelApp.View.Scenario"
        xmlns:res="clr-namespace:ETS.Resources;assembly=ETS.Resources"
        Title="Редактирование меню Телеграм бота"
        Width="600"
        Height="450"
        Background="{DynamicResource GlobalBackgroundColor}"
        BorderThickness="1"
        ResizeMode="NoResize"
        ShowIcon="False"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300*" />
            <RowDefinition Height="63" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0 0 0 0">

            <!--  Имя или описание аккаунта  -->
            <Grid Height="25" Margin="0 10 0 0">
                <ex:ExTextBlock
                                Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                Text="Название">
                </ex:ExTextBlock>
                <ex:ExTextBox x:Name="TxbxName"
                              Height="25"
                              Margin="180 0 10 0"
                              VerticalAlignment="Center"
                              Text="" />
            </Grid>
            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock 
                      Margin="10 0 0 0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Cursor="Help"
                      Text="Название меню ТГ">
                </ex:ExTextBlock>
                <ex:ExTextBox x:Name="TxbxNameMenu"
                    Height="25"
                    Margin="180 0 10 0"
                    VerticalAlignment="Center"
                    Text="" />
            </Grid>
            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock
                          Margin="10 0 0 0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Cursor="Help"
                          Text="Столбец">
                </ex:ExTextBlock>
                <ex:ExNumTextBox x:Name="TxbxColumn"
                        Height="25"
                        DecimalPlaces="0"
                        Margin="180 0 10 0"
                        VerticalAlignment="Center"
                        Text="" />
            </Grid>
            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock
                          Margin="10 0 0 0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Cursor="Help"
                          Text="Строка">
                </ex:ExTextBlock>
                <ex:ExNumTextBox x:Name="TxbxRow"
                        Height="25"
                        DecimalPlaces="0"
                        Margin="180 0 10 0"
                        VerticalAlignment="Center"
                        Text="" />
            </Grid>
            <Grid Margin="0 5 0 0">
                <ex:ExTextBlock
                          Margin="10 5 0 0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Cursor="Help"
                          Text="Ответ пользователю">
                </ex:ExTextBlock>
                <ex:ExTextBox x:Name="TxbxText"
                        Height="165"
                        Margin="180 0 10 0"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Text="" />
            </Grid>

        </StackPanel>

        <Grid Grid.Row="1" Background="{DynamicResource ExWindow-Footer-Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>
            <ex:ExButton x:Name="BtnCancel" Grid.Column="0"
                         Width="120"
                         Height="25"
                         Background="Transparent"
                         Margin="0 0 6 0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Click="BtnCancel_Click"
                         FontSize="12"
                         IsCancel="True"
                         Style="{DynamicResource ExButtonCancel}"
                         TabIndex="10"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.CancelButtonKey}}" />
            <ex:ExButton x:Name="BtnSave" Grid.Column="1"
                         Width="120"
                         Height="25"
                         Margin="6 0 0 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Click="BtnSave_Click"
                         FontSize="12"
                         IsDefault="True"
                         Style="{DynamicResource ExButtonApply}"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.ApplyButtonKey}}" />
        </Grid>
    </Grid>
</ex:ExWindow>
