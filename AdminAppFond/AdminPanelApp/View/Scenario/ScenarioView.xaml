<ex:ExDockDocumentPanel x:Class="AdminPanelApp.View.Scenario.ScenarioView"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:local="clr-namespace:AdminPanelApp.View.Scenario"
                        mc:Ignorable="d"
                        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
                        Background="{DynamicResource GlobalBackgroundColor}"
                        BorderBrush="{DynamicResource ExWindow-Border-Background}"
                        BorderThickness="1"
                        Caption="Сценарии"
                        ShowBorder="False" >
    <Grid>
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="140*" />
            </Grid.RowDefinitions>
            <ex:ExButton Grid.Row="0"
                     Background="Transparent"
                     HorizontalAlignment="Left"
                     BorderBrush="Transparent"
                     Click="BtnAddScenario_Click"
                     Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-add.svg"
                     IconHeight="16"
                     IconWidth="16"
                     ToolTip="Добавить" />
            <ex:ExButton Name="BtnDelete" Grid.Row="0"
                     Background="Transparent"
                     Margin="32 0 0 0"
                     HorizontalAlignment="Left"
                     BorderBrush="Transparent"
                     Click="BtnDelScenario_Click"
                     Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-del.svg"
                     IconHeight="16"
                     IconWidth="16"
                     ToolTip="Удалить" />

            <Grid Grid.Row="1">

                <ex:ExSimpleTable Name="DtgdScenario" Grid.Column="0"
                              Height="Auto"
                              HorizontalContentAlignment="Left"
                              AlternatingRowBackground="{DynamicResource Ex-SimpleTable-AlternativeRow-Background}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              ColumnHeaderStyle="{DynamicResource ExDataGridColumnHeaderSortStyle}"
                              FrozenColumnCount="2"
                              GridLinesVisibility="Vertical"
                              IsReadOnly="True"
                              MouseDoubleClick="DtgdScenario_MouseDoubleClick"
                              SelectionMode="Single">



                    <ex:ExSimpleTable.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="MnitAddScenario_Click" Header="Добавить" />
                            <MenuItem Click="MnitEditScenario_Click" Header="Редактировать" />
                            <MenuItem Click="MnitDelScenario_Click" Header="Удалить" />

                        </ContextMenu>
                    </ex:ExSimpleTable.ContextMenu>

                    <ex:ExSimpleTable.Columns>
                        
                        <DataGridTemplateColumn IsReadOnly="True" Width="50" CanUserResize="False" CanUserReorder="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ex:ExToggleButton HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsChecked="{Binding Path=IsRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Binding="{Binding Name}" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Название" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding Type}" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Тип" />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                    </ex:ExSimpleTable.Columns>
                </ex:ExSimpleTable>

            </Grid>
        </Grid>


        <!--<GridSplitter Grid.Column="1"
                      Width="3"
                      Background="{DynamicResource Ex-Divider-Background}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="140*" />
            </Grid.RowDefinitions>
            <ex:ExButton Grid.Row="0"
                         Background="Transparent"
                         HorizontalAlignment="Left"
                         BorderBrush="Transparent"
                         Click="BtnAddTgMenu_Click"
                         Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-add.svg"
                         IconHeight="16"
                         IconWidth="16"
                         ToolTip="Добавить" />
            <ex:ExButton Grid.Row="0"
                         Background="Transparent"
                         Margin="32 0 0 0"
                         HorizontalAlignment="Left"
                         BorderBrush="Transparent"
                         Click="BtnDelTgMenu_Click"
                         Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-del.svg"
                         IconHeight="16"
                         IconWidth="16"
                         ToolTip="Удалить" />


            <ex:ExSimpleTable Name="DtgdTgMenu" Grid.Row="1"
                              Height="Auto"
                              HorizontalContentAlignment="Left"
                              AlternatingRowBackground="{DynamicResource Ex-SimpleTable-AlternativeRow-Background}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              ColumnHeaderStyle="{DynamicResource ExDataGridColumnHeaderSortStyle}"
                              FrozenColumnCount="2"
                              GridLinesVisibility="Vertical"
                              IsReadOnly="True"
                              MouseDoubleClick="DtgdTgMenu_MouseDoubleClick"
                              SelectionMode="Single">



                <ex:ExSimpleTable.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MnitAddTgMenu_Click" Header="Добавить" />
                        <MenuItem Click="MnitEditTgMenu_Click" Header="Редактировать" />
                        <MenuItem Click="MnitDelTgMenu_Click" Header="Удалить" />

                    </ContextMenu>
                </ex:ExSimpleTable.ContextMenu>

                <ex:ExSimpleTable.Columns>
                    <DataGridTextColumn Binding="{Binding AccountName}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Название счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Exchange}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Биржа" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding AccountNumber}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Номер счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Currency}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Валюта счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Дата создания" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </ex:ExSimpleTable.Columns>
            </ex:ExSimpleTable>


        </Grid>-->

    </Grid>
</ex:ExDockDocumentPanel>
