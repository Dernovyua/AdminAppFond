<UserControl x:Class="AdminPanelApp.View.Statistic.StatisticUc"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminPanelApp.View.Statistic"
             xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
             Background="{DynamicResource GlobalBackgroundColor}"
             BorderBrush="{DynamicResource ExWindow-Border-Background}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ex:ExSimpleTable Name="DtgdStatDetail" Grid.Column="2"
                         Height="Auto"
                         HorizontalContentAlignment="Left"
                         AlternatingRowBackground="{DynamicResource Ex-SimpleTable-AlternativeRow-Background}"
                         AutoGenerateColumns="False"
                         CanUserAddRows="False"
                         CanUserDeleteRows="False"
                         CanUserReorderColumns="True"
                         CanUserResizeColumns="True"
                         CanUserSortColumns="True"
                         ItemsSource="{Binding ElementName=DtgdStat, Path=SelectedItem.Account.Statistics}"
                         ColumnHeaderStyle="{DynamicResource ExDataGridColumnHeaderSortStyle}"
                         FrozenColumnCount="2"
                         GridLinesVisibility="Vertical"
                         IsReadOnly="True"
                         MouseDoubleClick="DtgdStat_MouseDoubleClick"
                         SelectionMode="Single">



            <ex:ExSimpleTable.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="MnitAddStat_Click" Header="Добавить" />
                    <MenuItem Click="MnitEditStat_Click" Header="Редактировать" />
                    <MenuItem Click="MnitDelStat_Click" Header="Удалить" />
                </ContextMenu>
            </ex:ExSimpleTable.ContextMenu>

            <ex:ExSimpleTable.Columns>

                <!--  Колонка с датой  -->
                <DataGridTextColumn Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy\}}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Дата" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!--  Колонка с ID счёта  --><!--
                <DataGridTextColumn Binding="{Binding AccountName}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Счет" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>-->

                <!--  Колонка баланса депозита  -->
                <DataGridTextColumn Binding="{Binding Deposit}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Баланс" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!--  Колонка с комментарием  -->
                <DataGridTextColumn Binding="{Binding Comment}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Комментарий" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

            </ex:ExSimpleTable.Columns>
        </ex:ExSimpleTable>
    </Grid>
</UserControl>
