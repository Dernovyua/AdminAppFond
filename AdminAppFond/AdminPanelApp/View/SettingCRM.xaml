<ex:ExWindow x:Class="AdminPanelApp.View.SettingCRM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdminPanelApp.View"
        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
        xmlns:res="clr-namespace:ETS.Resources;assembly=ETS.Resources"
        Title="Настройка CRM"
        Width="600"
        Height="660"
        Background="{DynamicResource GlobalBackgroundColor}"
        BorderThickness="1"
        ResizeMode="NoResize"
        ShowIcon="False"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300*" />
            <RowDefinition Height="63" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0 0 0 0">
            <Grid Height="25" Margin="0 10 0 0">
                <ex:ExTextBlock Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="Бот для взаимодействия с клиентами"
                                TextWrapping="Wrap" />

                <ex:ExButton x:Name="BtnGide"
                             Width="190"
                             Height="25"
                             Margin="0 0 10 0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Click="BtnGide_OnClick"
                             CornerRadius="2"
                             Style="{DynamicResource ExButtonDefault}"
                             Text="Инструкция по подключению" />

            </Grid>
            <Grid Height="25" Margin="0 10 0 0">
                <ex:ExTextBlock Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{DynamicResource {x:Static res:LanguageMainSettingKeys.TokenKey}}"
                                TextWrapping="Wrap" />
                <ex:ExTextBox Name="TxbxTokenAdmin"
                              Height="25"
                              Margin="90 0 10 0"
                              VerticalAlignment="Center"
                              Text=""
                              TextWrapping="Wrap" />

            </Grid>

            
        </StackPanel>

        <Grid Grid.Row="1" Background="{DynamicResource ExWindow-Footer-Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>
            <ex:ExButton x:Name="BtnCancel" Grid.Column="0"
                         Width="120"
                         Height="25"
                         Background="Transparent"
                         Margin="0 0 6 0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Click="BtnCancel_Click"
                         FontSize="12"
                         IsCancel="True"
                         Style="{DynamicResource ExButtonCancel}"
                         TabIndex="10"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.CancelButtonKey}}" />
            <ex:ExButton x:Name="BtnSave" Grid.Column="1"
                         Width="120"
                         Height="25"
                         Margin="6 0 0 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Click="BtnSave_Click"
                         FontSize="12"
                         IsDefault="True"
                         Style="{DynamicResource ExButtonApply}"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.ApplyButtonKey}}" />
        </Grid>
    </Grid>
</ex:ExWindow>
