<ex:ExDockDocumentPanel x:Class="AdminPanelApp.View.DialogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
                        xmlns:local="clr-namespace:AdminPanelApp.View"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        Background="{DynamicResource GlobalBackgroundColor}"
                        BorderBrush="{DynamicResource ExWindow-Border-Background}"
                        BorderThickness="1"
                        Caption="Чаты"
                        ShowBorder="False">

    <ex:ExDockDocumentPanel.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- конвертеры -->
        <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <local:MessageBubbleBackgroundConverter x:Key="MessageBubbleBackgroundConverter"/>

        <!-- кисти для пузырьков -->
        <SolidColorBrush x:Key="OwnMessageBubbleBackground" Color="#DCF8C6"/>
        <SolidColorBrush x:Key="OtherMessageBubbleBackground" Color="#FFFFFF"/>
    </ex:ExDockDocumentPanel.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <!-- Левая панель чатов -->
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <!-- Правая панель диалога -->
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Row="1"
                      Width="3"
                      Background="{DynamicResource Ex-Divider-Background}"
                      VerticalAlignment="Stretch" />
        <!-- Левая панель -->
        <DockPanel Background="{DynamicResource GlobalBackgroundColor}" MinWidth="320">

            <!-- Поиск -->
            <DockPanel DockPanel.Dock="Top" Margin="6" LastChildFill="True">
                <ex:ExTextBox x:Name="SearchBox"
                 Height="28"
                 Margin="0,4,0,4"
                 VerticalContentAlignment="Stretch"
                 FontSize="13"
                 Padding="10,2"
                 TextChanged="SearchBox_TextChanged" />
            </DockPanel>

            <!-- Список чатов -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,4,0,0"
                  DockPanel.Dock="Bottom"
                  Background="{DynamicResource GlobalBackgroundColor}">
                <ItemsControl x:Name="ChatList"
                      ItemsSource="{Binding FilteredChats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonDown="Chat_MouseDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Аватар -->
                                    <Ellipse Width="36"
                                     Height="36"
                                     Stroke="Gray"
                                     StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar}" />
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Имя и сообщение -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <ex:ExTextBlock Text="{Binding FullName}"
                                                FontWeight="Bold"
                                                FontSize="13"/>
                                        <TextBlock Text="{Binding LastMessage}"
                                           FontSize="11"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"/>
                                    </StackPanel>

                                    <!-- Время и индикатор -->
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="10"
                                           Foreground="Gray"
                                           Text="{Binding LastMessageTime, StringFormat='{}{0:HH:mm}'}"
                                           HorizontalAlignment="Right"/>
                                        <Ellipse Fill="DodgerBlue"
                                         Width="10"
                                         Height="10"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibilityConverter}}"
                                         HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Правая панель -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Заголовок -->
                <RowDefinition Height="*" />
                <!-- Переписка -->
                <RowDefinition Height="Auto" />
                <!-- Ввод -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Height="48" >
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <Ellipse Width="32" Height="32" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding SelectedChat.Avatar}" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Text="{Binding SelectedChat.FullName}" />
                        <TextBlock FontSize="10" Foreground="Gray" Text="{Binding SelectedChat.Status}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- История сообщений -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" >
                <ItemsControl ItemsSource="{Binding SelectedChat.Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="12" Padding="8" 
                                    Background="{Binding IsOwn, Converter={StaticResource MessageBubbleBackgroundConverter}}"
                                    HorizontalAlignment="{Binding IsOwn, Converter={StaticResource MessageAlignmentConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Height="120"/>
                                    <TextBlock FontSize="10" Foreground="Gray" HorizontalAlignment="Right"
                                               Text="{Binding SentAt}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Ввод сообщения -->
            <Grid Grid.Row="2" Margin="8" HorizontalAlignment="Stretch">
                <ex:ExTextBox Name="MessageInput"
                         VerticalAlignment="Center"
                         Height="100"
                         AcceptsReturn="True"
                         Margin="8 0 120 0"
                         Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}" />
                <ex:ExButton 
                    HorizontalAlignment="Right"
                            Style="{DynamicResource ExButtonApply}"
                            Text="Отправить"         
                            Margin="8,0,0,0"
                             Click="SendMessage_Click" />
            </Grid>
        </Grid>
    </Grid>
</ex:ExDockDocumentPanel>
