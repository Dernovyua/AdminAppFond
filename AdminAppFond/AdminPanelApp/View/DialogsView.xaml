<ex:ExDockDocumentPanel x:Class="AdminPanelApp.View.DialogsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
                        xmlns:local="clr-namespace:AdminPanelApp.View"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        Background="{DynamicResource GlobalBackgroundColor}"
                        BorderBrush="{DynamicResource ExWindow-Border-Background}"
                        BorderThickness="1"
                        Caption="Диалоги"
                        PreviewKeyDown="Window_PreviewKeyDown"
                        ShowBorder="False">

    <ex:ExDockDocumentPanel.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- конвертеры -->
        <local:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <local:MessageBubbleBackgroundConverter x:Key="MessageBubbleBackgroundConverter"/>

    </ex:ExDockDocumentPanel.Resources>

    <!--<ex:ExDockDocumentPanel.InputBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding YourButtonCommand}"/>
        --><!-- или с явным указанием клавиш --><!--
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding YourButtonCommand}"/>
    </ex:ExDockDocumentPanel.InputBindings>-->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <!-- Левая панель чатов -->
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <!-- Правая панель диалога -->
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1"
                      Width="3"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource Ex-Divider-Background}"  
                      VerticalAlignment="Stretch" />
        <!-- Левая панель -->
        <DockPanel Background="{DynamicResource GlobalBackgroundColor}" Grid.Column="0">

            <!-- Поиск -->
            <DockPanel DockPanel.Dock="Top" Margin="6" LastChildFill="True">
                <ex:ExTextBox x:Name="SearchBox"
                 CornerRadius="6"
                 Height="28"
                 Margin="0,4,0,4"
                 VerticalContentAlignment="Stretch"
                 FontSize="13"
                 Padding="10,2"
                 TextChanged="SearchBox_TextChanged" />
            </DockPanel>

            <!-- Список чатов -->
            <ex:ExScrollView VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,4,0,0"
                  DockPanel.Dock="Bottom"
                  Background="{DynamicResource GlobalBackgroundColor}">
                <ItemsControl x:Name="ChatList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4"
                            Padding="6"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonDown="Chat_MouseDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource  Ex-SimpleTable-AlternativeRow-Background}"/>
                                                <!-- светло-синий фон -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>


                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Аватар -->
                                    <!--<Ellipse Width="36"
                                     Height="36"
                                     Stroke="Gray"
                                     StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Avatar}" />
                                        </Ellipse.Fill>
                                    </Ellipse>-->

                                    <!-- Имя и сообщение -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxHeight="35">
                                        <ex:ExTextBlock Text="{Binding FullName}"
                                                FontWeight="Bold"
                                                FontSize="13"/>
                                        <TextBlock Text="{Binding Chat.LastMessage}"
                                           FontSize="11"
                                           Margin="20 6 0 0"
                                           Foreground="Gray"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="200"/>
                                    </StackPanel>

                                    <!-- Время и индикатор -->
                                    <StackPanel Grid.Column="2" Margin="4,2,0,0" >
                                        <TextBlock FontSize="10"
                                           Foreground="Gray"
                                           Text="{Binding Chat.LastMessageTime, StringFormat='{}{0:HH:mm}'}"
                                                   
                                           HorizontalAlignment="Right"/>
                                        <Ellipse Fill="DodgerBlue"
                                         Width="10"
                                         Height="10"
                                         Margin="0,6,0,0"
                                         Visibility="{Binding Chat.IsUnread, Converter={StaticResource BoolToVisibilityConverter}}"
                                         HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ex:ExScrollView>
        </DockPanel>
        <!-- Правая панель -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Заголовок -->
                <RowDefinition Height="*" />
                <!-- Переписка -->
                <RowDefinition Height="Auto" />
                <!-- Ввод -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Height="48" Margin="6 0 0 0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel>
                        <ex:ExTextBlock FontWeight="Bold" Text="{ Binding SelectedChat.FullName}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- История сообщений -->
            <ex:ExScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="6 0 0 0" x:Name="MessagesScrollView" >
                <ItemsControl ItemsSource="{Binding SelectedChat.Chat.Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 4 0 4" Padding="8"  CornerRadius="6"  MaxWidth="520" HorizontalAlignment="Left"
                                    Background="{Binding IsOwn, Converter={StaticResource MessageBubbleBackgroundConverter}}">
                                <StackPanel MinHeight="20">
                                    <ex:ExTextBox Text="{Binding Text}" 
                                                  IsReadOnly="True"
                                                  Height="Auto"
                                                  BorderBrush="Transparent"
                                                  Background="Transparent"
                                                               MinWidth="360"
                                                               FontSize="14"
                                                               TextWrapping="Wrap"/>
                                    <ex:ExTextBlock Margin="0 6 0 0" FontSize="10" HorizontalAlignment="Right"
                                               Text="{Binding SentAt,  StringFormat=\{0:dd.MM.yyyy  HH:mm\}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ex:ExScrollView>

            <!-- Ввод сообщения -->
            <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Stretch">
                <ex:ExTextBox Name="TxbxMessage"
                         VerticalAlignment="Center"
                         CornerRadius="10"
                         Height="100"
                         AcceptsReturn="True"
                         FontSize="16"
                         Margin="0 0 105 0"
                         Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}" />
                <ex:ExButton 
                    HorizontalAlignment="Right"
                            Style="{DynamicResource ExButtonApply}"
                            Text="Отправить"         
                            Margin="8,0,0,0"
                             Click="SendMessage_Click" >
                </ex:ExButton>
            </Grid>
        </Grid>
    </Grid>
</ex:ExDockDocumentPanel>
