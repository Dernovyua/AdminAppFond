<ex:ExDockDocumentPanel x:Class="AdminPanelApp.View.UcClients"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
                        xmlns:local="clr-namespace:AdminPanelApp.View"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:convertors="clr-namespace:AdminPanelApp.Logic"
                        Background="{DynamicResource GlobalBackgroundColor}"
                        BorderBrush="{DynamicResource ExWindow-Border-Background}"
                        BorderThickness="1"
                        Caption="Клиенты"
                        ShowBorder="False">

    <ex:ExDockDocumentPanel.Resources>
        <convertors:ColorForegroundConverter x:Key="ColorConverter" />
    </ex:ExDockDocumentPanel.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="140*" />
            <RowDefinition Height="3" />
            <RowDefinition Height="250" />
        </Grid.RowDefinitions>


        <ex:ExButton Name="ButtonAddRow" Grid.Row="0"
                     Background="Transparent"
                     HorizontalAlignment="Left"
                     BorderBrush="Transparent"
                     Click="BtnAddClient_Click"
                     Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-add.svg"
                     IconHeight="16"
                     IconWidth="16"
                     ToolTip="Добавить" />
        <ex:ExButton Name="BtnDelete" Grid.Row="0"
                     Background="Transparent"
                     Margin="32 0 0 0"
                     HorizontalAlignment="Left"
                     BorderBrush="Transparent"
                     Click="BtnDelClient_Click"
                     Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-del.svg"
                     IconHeight="16"
                     IconWidth="16"
                     ToolTip="Удалить" />

        <Grid Grid.Row="1">
            <!--<Grid.ColumnDefinitions>
                <ColumnDefinition Width="21*" />

                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>-->


            <ex:ExSimpleTable Name="DtgdClients" Grid.Column="0"
                              Height="Auto"
                              HorizontalContentAlignment="Left"
                              AlternatingRowBackground="{DynamicResource Ex-SimpleTable-AlternativeRow-Background}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              ColumnHeaderStyle="{DynamicResource ExDataGridColumnHeaderSortStyle}"
                              FrozenColumnCount="2"
                              GridLinesVisibility="Vertical"
                              IsReadOnly="True"
                              MouseDoubleClick="DtgdClients_MouseDoubleClick"
                              SelectionChanged="DtgdClients_OnSelectionChanged"
                              SelectionMode="Single">



                <ex:ExSimpleTable.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MnitAddClient_Click" Header="Добавить" />
                        <MenuItem Click="MnitEditClient_Click" Header="Редактировать" />
                        <MenuItem Click="MnitDelClient_Click" Header="Удалить" />
                        <Separator />
                        <MenuItem Click="MnitAddAccount_Click" Header="Добавить счет" />
                    </ContextMenu>
                </ex:ExSimpleTable.ContextMenu>

                <ex:ExSimpleTable.Columns>

                    <!--  Колонка с ФИО клиента  -->
                    <DataGridTextColumn Binding="{Binding FullName}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="ФИО" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!--  Колонка со статусом клиента  -->
                    <DataGridTextColumn Binding="{Binding Status}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Статус" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding City}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Город" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!--  Колонка с датой открытия (регистрации) клиента  -->
                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Дата регистрации" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Phone}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Телефон" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Email}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Email" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Telegram}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Telegram" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ChatId}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Chat Id" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>


                    <DataGridTextColumn Binding="{Binding SuccessFee}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Плата за успех, %" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Notes}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Примечания" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                </ex:ExSimpleTable.Columns>
            </ex:ExSimpleTable>

            <!--<GridSplitter Grid.Column="1"
                          Background="{DynamicResource Ex-Divider-Background}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />-->


            <!--<Grid Grid.Column="2" Margin="0 0 0 0">
                <Grid MinHeight="100" />
            </Grid>-->
        </Grid>
        <GridSplitter Grid.Row="2"
                      Height="3"
                      Background="{DynamicResource Ex-Divider-Background}"
                      HorizontalAlignment="Stretch" />
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="140*" />
            </Grid.RowDefinitions>
            <ex:ExButton Name="ButtonAddAccount" Grid.Row="0"
                         Background="Transparent"
                         HorizontalAlignment="Left"
                         BorderBrush="Transparent"
                         Click="ButtonAddAccount_Click"
                         Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-add.svg"
                         IconHeight="16"
                         IconWidth="16"
                         ToolTip="Добавить" />
            <ex:ExButton Name="BtnDeleteAccount" Grid.Row="0"
                         Background="Transparent"
                         Margin="32 0 0 0"
                         HorizontalAlignment="Left"
                         BorderBrush="Transparent"
                         Click="BtnDeleteAccount_Click"
                         Icon="pack://application:,,,/Ex.UI.Kit;component/Resources/Icons/icon-del.svg"
                         IconHeight="16"
                         IconWidth="16"
                         ToolTip="Удалить" />


            <ex:ExSimpleTable Name="DtgdAccounts" Grid.Row="1"
                              Height="Auto"
                              HorizontalContentAlignment="Left"
                              AlternatingRowBackground="{DynamicResource Ex-SimpleTable-AlternativeRow-Background}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              ColumnHeaderStyle="{DynamicResource ExDataGridColumnHeaderSortStyle}"
                              FrozenColumnCount="2"
                              GridLinesVisibility="Vertical"
                              IsReadOnly="True"
                              ItemsSource="{Binding ElementName=DtgdClients, Path=SelectedItem.Accounts}"
                              MouseDoubleClick="DtgdAccounts_MouseDoubleClick"
                              SelectionMode="Single">



                <ex:ExSimpleTable.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MnitAddAccount_Click" Header="Добавить" />
                        <MenuItem Click="MnitEditAccount_Click" Header="Редактировать" />
                        <MenuItem Click="MnitDelAccount_Click" Header="Удалить" />

                    </ContextMenu>
                </ex:ExSimpleTable.ContextMenu>

                <ex:ExSimpleTable.Columns>
                    <DataGridTextColumn Binding="{Binding AccountName}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Название счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Exchange}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Биржа" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding AccountNumber}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Номер счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Statistic.Balance, StringFormat=\{0:F2\}}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Баланс" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <!-- Доходность за весь период -->
                    <DataGridTextColumn Binding="{Binding Statistic.TotalReturn, StringFormat=\{0:F2\}%}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Весь период, %" />
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style BasedOn="{StaticResource ExDataGridCellStyle}" TargetType="DataGridCell">
                                <Style.Setters>
                                    <Setter Property="Foreground" Value="{Binding Statistic.TotalReturn, Converter={StaticResource ColorConverter}}" />
                                    <Setter Property="Opacity" Value="1" />
                                </Style.Setters>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Currency}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Валюта счета" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy\}}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <ex:ExTextBlock Foreground="{DynamicResource Ex-SimpleTable-Header-Foreground}" Text="Дата создания" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </ex:ExSimpleTable.Columns>
            </ex:ExSimpleTable>


        </Grid>

    </Grid>
</ex:ExDockDocumentPanel>
