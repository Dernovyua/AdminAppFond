<ex:ExWindow x:Class="AdminPanelApp.View.AddTransaction"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:ex="clr-namespace:Ex.UI.Kit;assembly=Ex.UI.Kit"
                 xmlns:local="clr-namespace:AdminPanelApp.View"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:res="clr-namespace:ETS.Resources;assembly=ETS.Resources"
                 Title="Настройка транзакции"
                 Width="400"
                 Height="450"
                 Background="{DynamicResource GlobalBackgroundColor}"
                 BorderThickness="1"
                 ResizeMode="NoResize"
                 ShowIcon="False"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="300*" />
            <RowDefinition Height="63" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0 0 0 0">


            <!--  Статус клиента  -->
            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock
                                Width="120"
                                Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                Text="Счет">
                </ex:ExTextBlock>
                <ex:ExComboBox x:Name="CmbxAccount"
                               Height="25"
                               Margin="180 0 10 0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               DisplayMember="AccountName"
                               SelectedIndex="0" />
            </Grid>

            <!-- Дата обработки -->
            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock Text="Дата обработки"
                       Width="120"
                       Margin="10 0 0 0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                <ex:ExDatePicker x:Name="DtpProcessedAt"
                        Height="25"
                        Margin="180 0 10 0"
                        VerticalAlignment="Center"/>
            </Grid>

            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock 
                                Width="120"
                                Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                Text="Тип операции">
                </ex:ExTextBlock>
                <ex:ExComboBox x:Name="CmbxType"
                               Height="25"
                               Margin="180 0 10 0"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center"
                               SelectedIndex="0" />
            </Grid>

            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock
                                Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                Text="Сумма">
                </ex:ExTextBlock>
                <ex:ExTextBox x:Name="TxbxDeposit"
                              Height="25"
                              Margin="180 0 10 0"
                              VerticalAlignment="Center"
                              Text="" />
            </Grid>


            <Grid Height="25" Margin="0 5 0 0">
                <ex:ExTextBlock x:Name="TxblNotes"
                                Margin="10 0 0 0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Cursor="Help"
                                Text="Примечание">
                    <ex:ExTextBlock.ToolTip>
                        <ToolTip>
                            <DockPanel Width="250">
                                <ex:ExTextBlock Height="Auto" TextWrapping="Wrap">
                                    <Run Text="Введите примечание" />
                                </ex:ExTextBlock>
                            </DockPanel>
                        </ToolTip>
                    </ex:ExTextBlock.ToolTip>
                </ex:ExTextBlock>
                <ex:ExTextBox x:Name="TxbxNotes"
                              Height="25"
                              Margin="180 0 10 0"
                              VerticalAlignment="Center"
                              Text="" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Background="{DynamicResource ExWindow-Footer-Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>
            <ex:ExButton x:Name="BtnCancel" Grid.Column="0"
                         Width="120"
                         Height="25"
                         Background="Transparent"
                         Margin="0 0 6 0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Click="BtnCancel_Click"
                         FontSize="12"
                         IsCancel="True"
                         Style="{DynamicResource ExButtonCancel}"
                         TabIndex="10"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.CancelButtonKey}}" />
            <ex:ExButton x:Name="BtnSave" Grid.Column="1"
                         Width="120"
                         Height="25"
                         Margin="6 0 0 0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Click="BtnSave_Click"
                         FontSize="12"
                         IsDefault="True"
                         Style="{DynamicResource ExButtonApply}"
                         Text="{DynamicResource {x:Static res:LanguageQuikKey.ApplyButtonKey}}" />
        </Grid>
    </Grid>
</ex:ExWindow>
